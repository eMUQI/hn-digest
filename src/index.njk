---
layout: layouts/base.njk
hasToc: true
permalink: /index.html
eleventyExcludeFromCollections: true
---
{% set latest = collections.digest | last %}
{% if latest %}
{% set previous = collections.digest[collections.digest.length - 2] if collections.digest.length > 1 else null %}
<article class="digest">
  <p class="digest-date">{{ latest.date | dateCN }}</p>
  <h1>{{ latest.data.title }}</h1>
  <p class="digest-lede">共 30 条，含中文摘要、原文与讨论链接</p>
  <div class="palma-mode-row">
    <button class="palma-mode-toggle" type="button" data-palma-toggle aria-pressed="false">Palma 2 模式</button>
    <span class="palma-reader-hint">轻点屏幕左侧翻上一屏、右侧翻下一屏，也可直接上下滑动</span>
  </div>

  <div class="prose">
    {{ latest.templateContent | enhanceDigest | safe }}
  </div>
</article>

<nav class="pager">
  {% if previous %}<a href="{{ previous.url | url }}" data-palma-nav="previous">← 前一期</a>{% else %}<span></span>{% endif %}
  <a href="{{ latest.url | url }}">本期固定链接</a>
  <a class="muted" href="{{ '/archive/' | url }}">全部归档</a>
</nav>
{% else %}
<article class="digest">
  <h1>还没有内容</h1>
  <p class="digest-lede">第一期生成后，这里会显示当天的 Hacker News 中文摘要。</p>
</article>
{% endif %}
