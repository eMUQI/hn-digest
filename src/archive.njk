---
layout: layouts/base.njk
title: 归档
permalink: /archive/index.html
eleventyExcludeFromCollections: true
---
<article class="page">
  <h1>归档</h1>
  <p class="digest-lede">每日一期，按月份排列。</p>

  <div class="archive">
    {% for group in collections.digest | byMonth %}
    <div class="archive-month">
      <p class="archive-label">{{ group.label }}</p>
      <div class="archive-days">
        {% for item in group.items %}
        <a href="{{ item.url | url }}" title="{{ item.date | dateISO }}">{{ item.date | dayLabel }}</a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</article>
