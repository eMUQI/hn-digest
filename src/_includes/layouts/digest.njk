---
layout: layouts/base.njk
hasToc: true
---
{% set prev = collections.digest | getPreviousCollectionItem %}
{% set next = collections.digest | getNextCollectionItem %}

<article class="digest">
  <p class="digest-date">{{ date | dateCN }}</p>
  <h1>{{ title }}</h1>
  <p class="digest-lede">共 30 条，含中文摘要、原文与讨论链接</p>
  <div class="palma-mode-row">
    <button class="palma-mode-toggle" type="button" data-palma-toggle aria-pressed="false">墨水屏模式</button>
    <span class="palma-reader-hint">轻点屏幕左侧翻上一屏、右侧翻下一屏，也可直接上下滑动</span>
  </div>

  <div class="prose">
    {{ content | enhanceDigest | safe }}
  </div>
</article>

<nav class="pager">
  {% if prev %}<a href="{{ prev.url | url }}" data-palma-nav="previous">← 前一期</a>{% else %}<span></span>{% endif %}
  <a class="muted" href="{{ '/archive/' | url }}">全部归档</a>
  {% if next %}<a href="{{ next.url | url }}" data-palma-nav="next">后一期 →</a>{% else %}<span></span>{% endif %}
</nav>
