---
layout: layouts/base.njk
hasToc: true
---
{% set prev = collections.digest | getPreviousCollectionItem %}
{% set next = collections.digest | getNextCollectionItem %}

<article class="digest">
  <p class="digest-date">{{ date | dateCN }}</p>
  <h1>{{ title }}</h1>
  {% if description %}<p class="digest-lede">{{ description }}</p>{% endif %}

  <div class="prose">
    {{ content | enhanceDigest | safe }}
  </div>
</article>

<nav class="pager">
  {% if prev %}<a href="{{ prev.url | url }}">← 前一期</a>{% else %}<span></span>{% endif %}
  <a class="muted" href="{{ '/archive/' | url }}">全部归档</a>
  {% if next %}<a href="{{ next.url | url }}">后一期 →</a>{% else %}<span></span>{% endif %}
</nav>
