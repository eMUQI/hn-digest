<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ title }}{% if title != "Hacker News 中文早报" %} · Hacker News 中文早报{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="{{ '/' | url }}">HN 中文早报</a>
      <nav aria-label="主导航">
        <a href="{{ '/' | url }}">最新</a>
        <a href="{{ '/archive/' | url }}">归档</a>
      </nav>
    </div>
  </header>
  <main class="shell">{{ content | safe }}</main>
  <footer class="site-footer shell"><p>每日整理 Hacker News 热门内容，保留原文与 HN 讨论入口。</p></footer>
</body>
</html>
