<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if hasToc %}<script>(function(){try{var p=new URLSearchParams(location.search);var q=p.get('mode');var s=localStorage.getItem('hn-digest-display-mode');document.documentElement.dataset.displayMode=(q==='palma2'||(q!=='standard'&&s==='palma2'))?'palma2':'standard';}catch(e){}})();</script>{% endif %}
{% if title %}{% set metaTitle = title + " · HN 中文摘要" %}{% else %}{% set metaTitle = "HN 中文摘要" %}{% endif %}
{% if description %}{% set metaDescription = description %}{% else %}{% set metaDescription = "每日 Hacker News 官方首页前 30 条的中文摘要与分类整理。" %}{% endif %}
{% if ogType %}{% set metaType = ogType %}{% else %}{% set metaType = "website" %}{% endif %}
{% set canonicalUrl = "https://emuqi.github.io" + (page.url | url) %}
{% set socialImage = "https://emuqi.github.io/hn-digest/assets/og-image.png" %}
{% set socialImageAlt = "HN 中文摘要 · 每日 Hacker News 首页前 30 条" %}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDescription }}">
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDescription }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:type" content="{{ metaType }}">
<meta property="og:site_name" content="HN 中文摘要">
<meta property="og:locale" content="zh_CN">
<meta property="og:image" content="{{ socialImage }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ socialImageAlt }}">
{% if metaType == "article" %}<meta property="article:published_time" content="{{ page.date | dateISOFull }}">
{% endif %}<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
<meta name="twitter:description" content="{{ metaDescription }}">
<meta name="twitter:image" content="{{ socialImage }}">
<meta name="twitter:image:alt" content="{{ socialImageAlt }}">
<link rel="icon" type="image/svg+xml" href="{{ '/assets/brand-mark.svg' | url }}">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v=20260823-v1">
<link rel="stylesheet" href="{{ '/assets/layout-fixes.css' | url }}?v=20260819-v1">
{% if hasToc %}<link rel="stylesheet" href="{{ '/assets/digest.css' | url }}?v=20260819-v3">{% endif %}
{% if hasToc %}<link rel="stylesheet" href="{{ '/assets/palma2.css' | url }}?v=20260819-v2">{% endif %}
<link rel="alternate" type="application/rss+xml" title="HN 中文摘要" href="{{ '/feed.xml' | url }}">
</head>
<body>
<header class="navbar">
  <div class="navbar-inner">
    <a class="brand" href="{{ '/' | url }}"><img class="brand-mark" src="{{ '/assets/brand-mark.svg' | url }}" alt="" width="32" height="32"><span class="brand-name">HN 中文摘要</span></a>
    <nav class="navbar-links">
      <a href="{{ '/' | url }}">今日</a><a href="{{ '/archive/' | url }}">归档</a><a href="{{ '/about/' | url }}">关于</a><a href="{{ '/feed.xml' | url }}" class="muted">RSS</a><a href="https://github.com/eMUQI/hn-digest" class="muted">GitHub</a>
    </nav>
  </div>
</header>
<div class="shell{% if not hasToc %} shell-single{% endif %}">
  <main>{{ content | safe }}</main>
  {% if hasToc %}<aside class="toc" id="toc" hidden><p class="toc-title">本页目录</p><nav class="toc-links"></nav></aside>{% endif %}
</div>
<footer class="site-footer"><div class="site-footer-inner"><span>内容每日自动生成，Markdown 存档于 content/daily/</span><span class="footer-links"><a href="{{ '/about/' | url }}">关于</a><a href="{{ '/feed.xml' | url }}">RSS</a></span></div></footer>
{% if hasToc %}<script src="{{ '/assets/digest.js' | url }}?v=20260819-v3" defer></script><script src="{{ '/assets/toc.js' | url }}?v=20260819-v3" defer></script><script type="module" src="{{ '/assets/palma2.js' | url }}?v=20260819-v2"></script>{% endif %}
</body>
</html>
