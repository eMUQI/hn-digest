<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}HN 中文摘要</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="icon" type="image/png" sizes="64x64" href="{{ '/assets/favicon.png' | url }}">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v=20260819-v3">
{% if hasToc %}<link rel="stylesheet" href="{{ '/assets/digest.css' | url }}?v=20260819-v3">{% endif %}
<link rel="alternate" type="application/rss+xml" title="HN 中文摘要" href="{{ '/feed.xml' | url }}">
</head>
<body>
<header class="navbar">
  <div class="navbar-inner">
    <a class="brand" href="{{ '/' | url }}"><span class="brand-mark"><img src="{{ '/assets/hn-brand.png' | url }}" alt="" width="32" height="32" style="display:block;width:100%;height:100%;object-fit:cover;border-radius:50%"></span><span class="brand-name">HN 中文摘要</span></a>
    <nav class="navbar-links">
      <a href="{{ '/' | url }}">今日</a><a href="{{ '/archive/' | url }}">归档</a><a href="{{ '/about/' | url }}">关于</a><a href="{{ '/feed.xml' | url }}" class="muted">RSS</a><a href="https://github.com/eMUQI/hn-digest" class="muted">GitHub</a>
    </nav>
  </div>
</header>
<div class="shell{% if not hasToc %} shell-single{% endif %}">
  <main>{{ content | safe }}</main>
  {% if hasToc %}<aside class="toc" id="toc" hidden><p class="toc-title">本页目录</p><nav class="toc-links"></nav></aside>{% endif %}
</div>
<footer class="site-footer"><div class="site-footer-inner"><span>内容每日自动生成，Markdown 存档于 content/daily/</span><a href="{{ '/about/' | url }}">关于</a><a href="{{ '/feed.xml' | url }}">RSS</a></div></footer>
{% if hasToc %}<script src="{{ '/assets/digest.js' | url }}?v=20260819-v3" defer></script><script src="{{ '/assets/toc.js' | url }}?v=20260819-v3" defer></script>{% endif %}
</body>
</html>
